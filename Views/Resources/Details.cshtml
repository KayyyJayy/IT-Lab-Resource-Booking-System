@model Resource
@{
    ViewData["Title"] = Model.Name;
}

<div class="my-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-1"></i>Back to Resources</a>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="bg-white rounded-4 border p-4">
                @{
                    var (icon, color) = Model.Type switch {
                        ResourceType.ComputerLab => ("bi-display", "primary"),
                        ResourceType.Workstation => ("bi-pc-display", "info"),
                        ResourceType.Projector   => ("bi-projector", "warning"),
                        _                        => ("bi-speaker", "secondary")
                    };
                }
                <div class="mb-3">
                    <span class="resource-type-badge bg-@color bg-opacity-10 text-@color fs-6 px-3 py-2">
                        <i class="bi @icon me-2"></i>@Model.Type
                    </span>
                </div>
                <h4 class="fw-semibold">@Model.Name</h4>
                <p class="text-muted">@Model.Description</p>
                <ul class="list-unstyled text-muted small">
                    <li class="mb-1"><i class="bi bi-geo-alt me-2"></i>@Model.Location</li>
                    <li class="mb-1"><i class="bi bi-people me-2"></i>Capacity: @Model.Capacity seat(s)</li>
                    <li class="mb-1">
                        <i class="bi bi-circle-fill me-2 @(Model.IsAvailable ? "text-success" : "text-danger")" style="font-size:0.5rem;vertical-align:middle;"></i>
                        @(Model.IsAvailable ? "Available for booking" : "Not currently available")
                    </li>
                </ul>
                @if (Model.IsAvailable)
                {
                    <a asp-controller="Bookings" asp-action="Create" asp-route-resourceId="@Model.Id"
                       class="btn btn-primary w-100 mt-2">
                        <i class="bi bi-calendar-plus me-2"></i>Book This Resource
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100 mt-2">
                        <i class="bi bi-pencil me-2"></i>Edit Resource
                    </a>
                }
            </div>
        </div>

        <div class="col-md-7">
            <div class="bg-white rounded-4 border p-4">
                <h6 class="fw-semibold mb-3"><i class="bi bi-calendar3 me-2 text-primary"></i>Upcoming Bookings</h6>
                @{
                    var upcoming = Model.Bookings
                        .Where(b => b.Status == BookingStatus.Approved || b.Status == BookingStatus.Pending)
                        .OrderBy(b => b.StartTime).ToList();
                }
                @if (!upcoming.Any())
                {
                    <p class="text-muted text-center py-4"><i class="bi bi-calendar-check fs-2 d-block mb-2"></i>No upcoming bookings — this resource is free!</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var b in upcoming)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold small">@b.StartTime.ToString("dddd dd MMM yyyy")</div>
                                        <div class="text-muted small">@b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm") &nbsp;·&nbsp; @b.User.FullName</div>
                                    </div>
                                    <span class="badge badge-@b.Status.ToString()">@b.Status</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
