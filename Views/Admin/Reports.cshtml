@model ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="my-4">
    <h4 class="fw-semibold mb-1">Usage Reports</h4>
    <p class="text-muted small mb-4">Analyse booking activity and resource utilisation.</p>

    <!-- Date filter -->
    <form method="get" class="row g-2 mb-4 bg-white p-3 rounded-4 border">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">From</label>
            <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">To</label>
            <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-bar-chart me-2"></i>Generate Report</button>
        </div>
    </form>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <div class="stat-card text-center">
                <div class="stat-number">@Model.TotalBookings</div>
                <div class="stat-label">Total</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center">
                <div class="stat-number text-success">@Model.ApprovedBookings</div>
                <div class="stat-label">Approved</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center">
                <div class="stat-number text-danger">@Model.RejectedBookings</div>
                <div class="stat-label">Rejected</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center">
                <div class="stat-number text-secondary">@Model.CancelledBookings</div>
                <div class="stat-label">Cancelled</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="stat-card text-center">
                <div class="stat-number text-warning">@Model.PendingBookings</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
    </div>

    <!-- Resource usage table -->
    @if (Model.ResourceUsage.Any())
    {
        <div class="bg-white rounded-4 border p-3 mb-4">
            <h6 class="fw-semibold mb-3"><i class="bi bi-hdd-stack me-2 text-primary"></i>Resource Utilisation (Approved Bookings)</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Resource</th><th>Type</th><th>Bookings</th><th>Total Hours</th><th>Utilisation</th></tr>
                    </thead>
                    <tbody>
                        @{
                            var maxBookings = Model.ResourceUsage.Max(r => r.BookingCount);
                        }
                        @foreach (var r in Model.ResourceUsage)
                        {
                            var pct = maxBookings > 0 ? (int)((double)r.BookingCount / maxBookings * 100) : 0;
                            <tr>
                                <td class="fw-semibold">@r.ResourceName</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@r.ResourceType</span></td>
                                <td>@r.BookingCount</td>
                                <td>@r.TotalHours.ToString("F1")h</td>
                                <td style="min-width:120px">
                                    <div class="progress" style="height:8px">
                                        <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Booking history -->
    <div class="bg-white rounded-4 border p-3">
        <h6 class="fw-semibold mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Booking History</h6>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr><th>#</th><th>User</th><th>Resource</th><th>Date</th><th>Time</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @if (!Model.BookingHistory.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">No bookings in selected period.</td></tr>
                    }
                    @foreach (var b in Model.BookingHistory)
                    {
                        <tr>
                            <td class="text-muted small">@b.Id</td>
                            <td>@b.User.FullName</td>
                            <td>@b.Resource.Name</td>
                            <td class="small">@b.StartTime.ToString("dd MMM yyyy")</td>
                            <td class="small">@b.StartTime.ToString("HH:mm") – @b.EndTime.ToString("HH:mm")</td>
                            <td><span class="badge badge-@b.Status.ToString()">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
