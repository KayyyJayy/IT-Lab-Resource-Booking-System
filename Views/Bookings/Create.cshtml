@model BookingViewModel
@{
    ViewData["Title"] = "New Booking";
}

<div class="my-4">
    <a asp-action="MyBookings" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-1"></i>My Bookings</a>
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="form-card">
                <h5 class="fw-semibold mb-1"><i class="bi bi-calendar-plus me-2 text-primary"></i>Request a Booking</h5>
                <p class="text-muted small mb-4">All bookings are subject to admin approval. You will see the status in My Bookings.</p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="ResourceId" class="form-label fw-semibold"></label>
                        <select asp-for="ResourceId" asp-items="Model.ResourceList" class="form-select">
                            <option value="">— Select a resource —</option>
                        </select>
                        <span asp-validation-for="ResourceId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-semibold"></label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control"
                                   value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label fw-semibold"></label>
                            <input asp-for="EndTime" type="datetime-local" class="form-control"
                                   value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NumberOfAttendees" class="form-label fw-semibold"></label>
                        <input asp-for="NumberOfAttendees" type="number" min="1" class="form-control" />
                        <span asp-validation-for="NumberOfAttendees" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Purpose" class="form-label fw-semibold"></label>
                        <textarea asp-for="Purpose" rows="3" class="form-control"
                                  placeholder="Describe what you will be using the resource for…"></textarea>
                        <span asp-validation-for="Purpose" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-2"></i>Submit Booking Request
                    </button>
                </form>
            </div>

            <!-- Info panel -->
            <div class="bg-white rounded-4 border p-3 mt-3">
                <h6 class="fw-semibold small mb-2"><i class="bi bi-info-circle me-2 text-info"></i>How bookings work</h6>
                <ol class="small text-muted mb-0 ps-3">
                    <li>Submit your request with a time slot and purpose.</li>
                    <li>The IT team reviews and approves or rejects it.</li>
                    <li>Check <strong>My Bookings</strong> for the latest status.</li>
                    <li>You can cancel a pending or approved booking anytime before it starts.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
